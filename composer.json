{
    "name": "3neti/philippine-reference-data",
    "description": "Versioned Philippine reference datasets with provenance for EMS validation and enrichment",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "LBHurtado\\PhilippineReferenceData\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LBHurtado\\PhilippineReferenceData\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "dataset:build:psgc": "php scripts/build-psgc-dataset.php resources/sources/psa/2026-09-30/PSGC-3Q-2026-Publication-Datafile.xlsx resources/datasets/philippine-geography/2026.3"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
